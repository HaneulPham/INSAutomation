# dev | staging | production-readonly
TEST_ENV=dev
RUN_LIVE_TESTS=false
ALLOW_MUTATIONS=false

CP_WEB_BASE_URL=http://127.0.0.1:3000
CP_DESKTOP_BASE_URL=http://127.0.0.1:3001
LIFEGUARD_MOBILE_BASE_URL=http://127.0.0.1:4723
SMART_HOME_API_URL=http://127.0.0.1:4000
ALARM_API_URL=http://127.0.0.1:4001
ACTIVITY_API_URL=http://127.0.0.1:4002

# Never commit real credentials.
INS_API_TOKEN=
INS_USERNAME=
INS_PASSWORD=

# Staging LifeGuardian password authentication
USER_API_URL=
AUTH_GRANT_TYPE=password
AUTH_TENANT=
CP_CLIENT_ID=
CP_CLIENT_SECRET=
CLN_AUTH_TOKEN=
USER_AUTH_UUID=

# LifeGuardian task retrieval
ASW_DOMAIN=
TASK_CLIENT_UUID=
TASK_CREATED_AT=

# Staging Smart Home dispatcher
# Keep actual credentials and test identifiers in an ignored local env file.
SHM_DOMAIN=
X-API-KEY=
HMAC_HASH_SECRET=
DISPATCHER_TEST_PHONE_NUMBER=
DISPATCHER_TEST_IMEI=
DISPATCHER_TEST_DEVICE_ID=
