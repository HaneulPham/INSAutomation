{
  "name": "ins-lifeguardian-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Safety-aware Playwright automation framework for INS LifeGuardian",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:framework": "playwright test --project=framework-smoke",
    "test:smoke": "tsx scripts/run-smoke.ts",
    "test:regression": "tsx scripts/run-regression.ts",
    "test:api": "playwright test --project=api",
    "test:cp-web": "playwright test --project=cp-web",
    "setup:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "validate:schemas": "tsx scripts/validate-schemas.ts",
    "validate:structure": "tsx scripts/validate/structure.ts",
    "validate": "npm run typecheck && npm run validate:structure && npm run validate:schemas && npm run test:framework"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  }
}
